# Copy to .env — that file is gitignored and must stay that way.

# Required. Pay-as-you-go, billed separately from a Perplexity subscription.
# https://www.perplexity.ai/account/api/group
PERPLEXITY_API_KEY=

# Optional. sonar (default, cheapest) | sonar-pro | sonar-reasoning-pro |
# sonar-deep-research. Deep research costs substantially more per query.
# PROMPTIPLEX_MODEL=sonar

# Optional. Path to a module default-exporting a SearchProvider, used instead
# of the Perplexity API. See src/lib/search/index.ts.
# PROMPTIPLEX_PROVIDER_MODULE=./local/my-provider.ts

# Optional. Defaults to ./promptiplex.db
# PROMPTIPLEX_DB_PATH=

# Optional. The port `npm run dev` and `npm start` listen on. Defaults to 3000,
# which is a busy port on a machine running more than one web project. The
# hostname is not configurable — see README, "Running it safely".
# PORT=3000
